{
  "manifest_version": 3,
  "name": "Askme",
  "version": "1.12.0",
  "version_name": "1.12.0 · 2026.10.04.3",
  "description": "面向 UNSW Moodle 的课程同步、问答与复习助手。",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "sidePanel",
    "unlimitedStorage",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://moodle.telt.unsw.edu.au/*",
    "http://127.0.0.1:4317/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://moodle.telt.unsw.edu.au/*"
      ],
      "js": [
        "ui-protocol.js",
        "content-ui-client.js",
        "overlay-host.js",
        "panel-controller.js",
        "office-range.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/askme-16.png",
        "assets/askme-32.png",
        "assets/askme-48.png",
        "assets/askme-128.png",
        "assets/askme-open-panel-48.png",
        "assets/askme-open-panel-128.png",
        "assets/folder.svg",
        "assets/journal-text.svg"
      ],
      "matches": [
        "https://moodle.telt.unsw.edu.au/*"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开 Askme",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/askme-16.png",
      "32": "assets/askme-32.png",
      "48": "assets/askme-48.png",
      "128": "assets/askme-128.png"
    }
  },
  "icons": {
    "16": "assets/askme-16.png",
    "32": "assets/askme-32.png",
    "48": "assets/askme-48.png",
    "128": "assets/askme-128.png"
  },
  "side_panel": {
    "default_path": "panel.html"
  }
}
